# Copiar a ".env" y completar. El archivo .env NUNCA se sube a git.

# URL del proyecto Supabase
SUPABASE_URL=https://xqphjvppfgwabfruyjae.supabase.co

# Secret key (sb_secret_...). Supabase → Project Settings → API Keys.
# Salta el RLS: úsese solo en herramientas locales, nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña de Postgres (conexión por pooler). Supabase → Database → Settings.
SUPABASE_DB_PASSWORD=
